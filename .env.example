# Apenas no servidor. Sem chave/modelo: fallback mock automático.
# BUYERLAB_PROVIDER=openai (padrão) usa OPENAI_API_KEY/OPENAI_MODEL abaixo.
# BUYERLAB_PROVIDER=gemini usa GEMINI_API_KEY/GEMINI_MODEL. BUYERLAB_PROVIDER=mock ignora ambos.
OPENAI_API_KEY=
OPENAI_MODEL=
BUYERLAB_PROVIDER=openai
# Alternativa ao OpenAI: gere uma chave gratuita em https://aistudio.google.com/apikey.
# Modelo sugerido: gemini-2.5-flash (ou outro compatível com saída JSON estruturada da conta).
GEMINI_API_KEY=
GEMINI_MODEL=
# SQLite local; produção exige volume persistente e uma instância Node.
BUYERLAB_DB_PATH=.data/buyerlab.sqlite
PORT=8080
# Mercado consultado no servidor ao iniciar treinamento. static para demonstração offline.
BUYERLAB_MARKET_PROVIDER=live
# Opcional: sem chave, consulta agregador público, sujeito a atraso/indisponibilidade.
METALS_DEV_API_KEY=
# Painel "Indicadores de mercado" do dossiê (independente do benchmark acima). Gere uma chave
# gratuita em https://www.alphavantage.co/support/#api-key (limite: 25 req/dia, 5/min). Sem
# chave, o alumínio do painel aparece como SIMULADO. PTAX e PIM-PF não exigem chave.
ALPHA_VANTAGE_API_KEY=
